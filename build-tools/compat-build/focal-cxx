#!/bin/sh
set -eu
root="${FASTPREP_FOCAL_SYSROOT:?set to extracted Ubuntu 20.04 sysroot}"
multi=x86_64-linux-gnu
export LD_LIBRARY_PATH="$FASTPREP_COMPILER_LIB${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$root/usr/bin/$multi-g++-9" --sysroot="$root" -B"$root/usr/lib/gcc/$multi/9/" -B"$root/usr/lib/$multi/" -Wl,-rpath-link,"$root/lib/$multi:$root/usr/lib/$multi" "$@"
