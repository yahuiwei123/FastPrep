includeConfig 'one-gpu.config'

// Six CPU threads leave room for two FLIRT workers on every GPU lane.
// Even the largest lane cannot admit two six-thread model tasks.
process {
    withName: /SESSION_NORMALIZE_MNI|ANAT_SYNTHSEG|ANAT_HDBET_MASK|ANAT_TISSUE_BIAS_CORRECT/ { cpus = 6 }
    withName: ANAT_MOTIONCOR { cpus = 2 }
}
