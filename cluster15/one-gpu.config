// Five pinned GPU workers share a 48 CPU, 400 GiB node.
executor {
    // Leave one core per node for the launchers.
    // Older launchers expose only the single pinned device.
    cpus = ['0', '1'].contains(System.getenv('FASTPREP_GPU_SLOT') ?: System.getenv('CUDA_VISIBLE_DEVICES')) ? 10 : 9
    memory = '72 GB'
    queueSize = 4
}
process {
    executor = 'local'

    // Keep the original task thread counts for existing Nextflow histories.
    // The local executor therefore admits only one CUDA stage across all sessions.
    withName: /SESSION_NORMALIZE_MNI|ANAT_SYNTHSEG|ANAT_HDBET_MASK|ANAT_TISSUE_BIAS_CORRECT/ { cpus = 8 }
    withName: /ANAT_FIX_TOPOLOGY|ANAT_WHITE_SURFACE|ANAT_PIAL_SURFACE|ANAT_SPHERE_REGISTER/ { cpus = 8 }

    withName: /ANAT_GET_T1W_FILE_IN_BIDS|ANAT_CREATE_SUBJECT_ORIG_DIR|ANAT_INPUT_QC|ANAT_ORIG_TO_NIFTI|ANAT_MASK_TO_MGZ|ANAT_PREPARE_SYNTHSEG_ASEG|SESSION_ALIGNMENT_QC/ { cpus = 1 }
    withName: /ANAT_SEGMENTATION_QC|ANAT_PREPROC_QC|ANAT_VOLUME_SUPPORT_QC/ { cpus = 2 }
    withName: SESSION_ALIGN_COMPANIONS {
        maxForks = 1
        cpus = 2
        ext.companion_workers = 2
    }
}
