manifest {
    name = 'fastprep-anat'
    version = '1.2.0'
    description = 'Standalone anatomical reconstruction with tissue-guided bias correction and optional T2 pial refinement'
    nextflowVersion = '>=25.10.0'
}

params {
    runtime = null
    blueprint = "${projectDir}/conf/workflow.json"
    helper_python = 'python3'
    threads = 8
    qc_threads = 8
    device = 'cuda:0'
    t1_placement_backend = 'gpu'
    t2_pial_backend = 'gpu'
    topology_backend = 'gpu'
    medial_wall_strategy = null
    pial_helpers = null
    pial_runtime = null
    white_helpers = null
    white_runtime = null
    intersection_helpers = null
    initialization_helpers = null
    initialization_blueprint = null
    motioncor_helpers = null
    mni_helpers = null
    sphere_helpers = null
    isolate_session_errors = false
    qc_mode = 'report_only'
    qc_surface_engine = 'reuse'
    outdir = "${launchDir}/results"
    help = false
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxForks = 2
    cpus = 1
    memory = '8 GB'
    withName: /.*HDBET.*/ { memory = '12 GB' }
    withName: /.*SYNTHSEG.*/ { memory = '16 GB' }
    withName: SESSION_NORMALIZE_MNI { memory = '16 GB' }
    // Serialize 8.1 mris_volmask's surface fields and their licensed I/O.
    withName: ANAT_RIBBON { cpus = 1 }
    withName: /.*SPHERE_REGISTER.*/ { memory = '16 GB' }
    withName: /.*_QC$/ { memory = '32 GB' }
    withName: /.*PIAL_RIBBON_QC.*/ { memory = '32 GB' }
    withName: /.*FSAVERAGE6_QC.*/ { memory = '32 GB' }
}

profiles {
    topology {
        params.runtime = "${projectDir}/tests/topology-runtime.json"
        params.threads = 1
        process.memory = '256 MB'
    }
    slurm {
        process.executor = 'slurm'
    }
}

env.PYTHONDONTWRITEBYTECODE = '1'
env.MPLBACKEND = 'Agg'
env.QT_QPA_PLATFORM = 'offscreen'
